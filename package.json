{
  "name": "agent-chat-bridge",
  "version": "0.2.6",
  "private": true,
  "type": "module",
  "description": "Independent Feishu and Codex client with durable hooks and message delivery",
  "engines": {
    "node": ">=24 <25"
  },
  "bin": {
    "agent-chat-bridge": "./bin/agent-chat-bridge.mjs"
  },
  "scripts": {
    "start": "node bin/agent-chat-bridge.mjs start",
    "test": "node --test test/*.test.mjs",
    "check": "node scripts/check.mjs",
    "test:storage": "node scripts/test-storage.mjs",
    "version:check": "node scripts/check-version.mjs"
  },
  "dependencies": {
    "@larksuiteoapi/node-sdk": "1.60.0",
    "https-proxy-agent": "7.0.6",
    "mdast-util-from-markdown": "2.0.3",
    "mysql2": "3.24.4"
  },
  "overrides": {
    "axios": "1.18.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Kosbling-ai/agent-chat-bridge.git"
  },
  "homepage": "https://github.com/Kosbling-ai/agent-chat-bridge",
  "bugs": {
    "url": "https://github.com/Kosbling-ai/agent-chat-bridge/issues"
  }
}
